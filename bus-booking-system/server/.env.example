PORT=5000
NODE_ENV=development
JSON_DB_PATH=./data/db.json
JWT_SECRET=replace_with_a_strong_random_jwt_secret
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Google OAuth (Customer Login Only)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Payment Mode: 'simulated' or 'razorpay_test'
PAYMENT_MODE=simulated
MERCHANT_UPI_ID=redbusclone@okaxis
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Optional Cloudinary for Bus/Profile Images
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
